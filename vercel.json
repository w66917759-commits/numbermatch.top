{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/update-sitemap.mjs",
  "installCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.numbermatch.top"
        }
      ],
      "destination": "https://numbermatch.top/:path*",
      "permanent": true
    }
  ]
}
